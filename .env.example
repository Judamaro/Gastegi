# Configuración por entorno de Gastegi.
#
# Estos valores NO se leen de este fichero en runtime: se pasan al compilar con
# --dart-define, y `app/config/` los recoge con String.fromEnvironment. Un .env
# empaquetado viajaría dentro del bundle como un asset que cualquiera puede
# abrir, así que no es sitio para nada sensible.
#
# Este fichero documenta qué variables existen y sirve de plantilla para un
# .env local que tu script de arranque puede convertir en --dart-define.
#
#   flutter run --dart-define=APP_ENV=staging
#
# development | staging | production. Por omisión, development.
APP_ENV=development

