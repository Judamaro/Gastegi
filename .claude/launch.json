{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gastegi-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "--web-port=8080"],
      "port": 8080
    },
    {
      "name": "gastegi-web-release",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "python3 -m http.server 8090 --directory build/web"],
      "port": 8090
    }
  ]
}
