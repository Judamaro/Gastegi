{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gastegi-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd gastegi && flutter run -d web-server --web-port=8080"],
      "port": 8080
    },
    {
      "name": "gastegi-web-release",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd gastegi/build/web && python3 -m http.server 8090"],
      "port": 8090
    }
  ]
}
